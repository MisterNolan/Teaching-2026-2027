<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Character Journey — Athens, 5th Century BCE</title>
<style>
  :root {
    --parchment: #EDE4D0;
    --parchment-dark: #E2D5B8;
    --ink: #2E2418;
    --ink-soft: #5A4A36;
    --oxblood: #7C2020;
    --oxblood-dark: #5C1717;
    --brass: #A9863F;
    --verdigris: #5B6E52;
    --verdigris-dark: #445039;
    --paper-edge: #D8C79E;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--parchment);
    color: var(--ink);
    font-family: Georgia, 'Iowan Old Style', Palatino, 'Palatino Linotype', serif;
    min-height: 100vh;
  }

  body {
    background-image:
      radial-gradient(ellipse at top left, rgba(169,134,63,0.08), transparent 60%),
      radial-gradient(ellipse at bottom right, rgba(92,23,23,0.06), transparent 55%);
  }

  .frame {
    max-width: 1040px;
    margin: 0 auto;
    padding: 28px 20px 80px;
  }

  header.title-block {
    text-align: center;
    border-bottom: 3px double var(--brass);
    padding-bottom: 18px;
    margin-bottom: 28px;
  }

  header.title-block .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin: 0 0 6px;
  }

  header.title-block h1 {
    font-size: 2.1rem;
    margin: 0 0 6px;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  header.title-block p.sub {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0;
    font-style: italic;
  }

  /* --- Name entry --- */
  #name-screen {
    max-width: 480px;
    margin: 60px auto;
    text-align: center;
  }

  #name-screen label {
    display: block;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--ink-soft);
  }

  #name-input {
    width: 100%;
    font-family: inherit;
    font-size: 1.2rem;
    padding: 10px 14px;
    border: 2px solid var(--brass);
    background: #FBF7EC;
    color: var(--ink);
    border-radius: 2px;
    text-align: center;
  }

  #name-input:focus { outline: 2px solid var(--oxblood); outline-offset: 2px; }

  .go-btn, .roll-btn, .restart-btn {
    font-family: inherit;
    font-size: 1.05rem;
    background: var(--oxblood);
    color: #F3E9D4;
    border: none;
    padding: 13px 30px;
    border-radius: 2px;
    cursor: pointer;
    margin-top: 20px;
    letter-spacing: 0.02em;
    transition: background 0.15s ease, transform 0.1s ease;
  }

  .go-btn:hover, .roll-btn:hover:not(:disabled), .restart-btn:hover {
    background: var(--oxblood-dark);
  }

  .go-btn:active, .roll-btn:active:not(:disabled) { transform: scale(0.98); }

  .roll-btn:disabled {
    background: #B7A98A;
    cursor: not-allowed;
  }

  /* --- Main game layout --- */
  #game-screen { display: none; }
  #game-screen.active { display: block; }

  .round-card {
    background: #FBF7EC;
    border: 1px solid var(--paper-edge);
    border-left: 5px solid var(--brass);
    padding: 22px 26px;
    border-radius: 2px;
    box-shadow: 0 2px 6px rgba(46,36,24,0.08);
    max-width: 560px;
    margin: 0 auto 36px;
  }

  .round-label {
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin: 0 0 4px;
    letter-spacing: 0.03em;
  }

  .round-title {
    font-size: 1.45rem;
    margin: 0 0 6px;
    font-weight: 400;
  }

  .current-branch-line {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .current-branch-line .free-word { color: var(--verdigris-dark); font-style: normal; }
  .current-branch-line .enslaved-word { color: var(--oxblood); font-style: normal; }

  .die-face {
    width: 60px;
    height: 60px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: #FBF7EC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    margin: 0 auto 14px;
  }

  .die-face.rolling { animation: shake 0.5s ease; }

  @keyframes shake {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(-12deg); }
    40% { transform: rotate(10deg); }
    60% { transform: rotate(-8deg); }
    80% { transform: rotate(6deg); }
  }

  .result-box {
    margin-top: 16px;
    padding: 14px 16px;
    background: var(--parchment-dark);
    border-left: 3px solid var(--oxblood);
    font-size: 1rem;
    line-height: 1.5;
    min-height: 1.4em;
    display: none;
  }

  .result-box.show { display: block; }

  .jump-note {
    margin-top: 8px;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--verdigris-dark);
  }

  .roll-area { text-align: center; }

  .continue-btn {
    display: none;
    margin-top: 16px;
  }
  .continue-btn.show { display: inline-block; }

  /* --- Tree visualization --- */
  .tree-section {
    background: #FBF7EC;
    border: 1px solid var(--paper-edge);
    border-radius: 2px;
    padding: 28px 24px 36px;
    margin-bottom: 36px;
  }

  .tree-heading {
    text-align: center;
    font-size: 0.95rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
    margin: 0 0 22px;
  }

  .tree-stage {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
  }

  .tree-roots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 8px;
    position: relative;
    z-index: 2;
  }

  .root-box {
    text-align: center;
    padding: 14px 10px;
    border-radius: 3px;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    border: 2px solid;
  }

  .root-box.free-root {
    color: var(--verdigris-dark);
    border-color: var(--verdigris);
    background: rgba(91,110,82,0.08);
  }

  .root-box.enslaved-root {
    color: var(--oxblood);
    border-color: var(--oxblood);
    background: rgba(124,32,32,0.06);
  }

  .tree-rows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    row-gap: 34px;
    position: relative;
    z-index: 2;
  }

  .tree-slot {
    min-height: 30px;
  }

  .tree-node {
    padding: 11px 13px;
    border-radius: 3px;
    font-size: 0.88rem;
    line-height: 1.4;
    border: 1px solid;
    background: #fff;
    position: relative;
  }

  .tree-node.free {
    border-color: var(--verdigris);
    background: rgba(91,110,82,0.05);
  }

  .tree-node.enslaved {
    border-color: var(--oxblood);
    background: rgba(124,32,32,0.04);
  }

  .tree-node .node-round {
    display: block;
    font-size: 0.68rem;
    color: var(--brass);
    margin-bottom: 3px;
    letter-spacing: 0.03em;
  }

  .tree-node .citizen-tag {
    display: inline-block;
    margin-top: 6px;
    font-size: 0.68rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .tree-node.enter-plain {
    animation: nodeFadeUp 0.45s ease both;
  }

  @keyframes nodeFadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tree-node.enter-cross-to-free {
    animation: crossToFree 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) both;
  }
  .tree-node.enter-cross-to-enslaved {
    animation: crossToEnslaved 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) both;
  }

  @keyframes crossToFree {
    from { opacity: 0; transform: translateX(115%) rotate(3deg); }
    60% { opacity: 1; }
    to { opacity: 1; transform: translateX(0) rotate(0deg); }
  }
  @keyframes crossToEnslaved {
    from { opacity: 0; transform: translateX(-115%) rotate(-3deg); }
    60% { opacity: 1; }
    to { opacity: 1; transform: translateX(0) rotate(0deg); }
  }

  #connector-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* --- Life record list --- */
  .record-card {
    background: #FBF7EC;
    border: 1px solid var(--paper-edge);
    padding: 22px 26px;
    border-radius: 2px;
    max-width: 640px;
    margin: 0 auto;
  }

  .record-card h2 {
    font-size: 1rem;
    margin: 0 0 4px;
    letter-spacing: 0.02em;
    font-weight: 400;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--paper-edge);
    padding-bottom: 10px;
  }

  .record-entries {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  .record-entries li {
    padding: 10px 0;
    border-bottom: 1px dashed var(--paper-edge);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .record-entries li:last-child { border-bottom: none; }

  .record-entries .r-num {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--brass);
    margin-right: 6px;
  }

  .record-empty {
    color: var(--ink-soft);
    font-style: italic;
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .tree-node { font-size: 0.8rem; padding: 9px 10px; }
    .root-box { font-size: 0.9rem; padding: 10px 6px; }
  }

  /* --- Final reveal --- */
  #final-screen {
    display: none;
    text-align: center;
    margin-top: 10px;
  }
  #final-screen.active { display: block; }

  .stamp {
    display: inline-block;
    border: 4px double var(--oxblood);
    color: var(--oxblood);
    padding: 14px 38px;
    font-size: 1.7rem;
    letter-spacing: 0.06em;
    transform: rotate(-2deg);
    margin: 10px 0 22px;
    background: rgba(124,32,32,0.04);
  }

  .stamp.free { border-color: var(--verdigris); color: var(--verdigris-dark); background: rgba(91,110,82,0.05); }

  #final-screen p.status-line {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin-bottom: 26px;
  }

  .speech-brief {
    text-align: left;
    max-width: 640px;
    margin: 0 auto;
    background: #FBF7EC;
    border: 1px solid var(--paper-edge);
    border-left: 5px solid var(--brass);
    padding: 24px 28px;
    border-radius: 2px;
  }

  .speech-brief h3 {
    font-weight: 400;
    font-size: 1.15rem;
    margin: 0 0 12px;
  }

  .speech-brief p { line-height: 1.6; margin: 0 0 12px; }
  .speech-brief p:last-child { margin-bottom: 0; }

  .full-record {
    text-align: left;
    max-width: 640px;
    margin: 30px auto 0;
  }

  .full-record h3 {
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--paper-edge);
    padding-bottom: 8px;
  }
</style>
</head>
<body>
<div class="frame">

  <header class="title-block">
    <p class="eyebrow">ATHENS, 5TH CENTURY BCE</p>
    <h1>Character Journey</h1>
    <p class="sub">Roll your way through a life. Then argue your place in it.</p>
  </header>

  <!-- NAME ENTRY -->
  <div id="name-screen">
    <label for="name-input">What is your character called?</label>
    <input id="name-input" type="text" placeholder="e.g. Demetria" maxlength="30">
    <br>
    <button class="go-btn" id="start-btn">Begin the Roll</button>
  </div>

  <!-- GAME SCREEN -->
  <div id="game-screen">

    <div class="round-card">
      <p class="round-label" id="round-label">ROUND 1 OF 5</p>
      <h2 class="round-title" id="round-title">Birth</h2>
      <p class="current-branch-line" id="current-branch-line">&nbsp;</p>

      <div class="roll-area">
        <div class="die-face" id="die-face">?</div>
        <button class="roll-btn" id="roll-btn">Roll the Die</button>
      </div>

      <div class="result-box" id="result-box"></div>
      <div class="jump-note" id="jump-note"></div>

      <div style="text-align:center;">
        <button class="continue-btn go-btn" id="continue-btn">Continue</button>
      </div>
    </div>

    <div class="tree-section">
      <p class="tree-heading" id="tree-heading">YOUR FAMILY TREE — <span style="color:var(--verdigris-dark);">FREE</span> or <span style="color:var(--oxblood);">ENSLAVED</span></p>
      <div class="tree-stage" id="tree-stage">
        <svg id="connector-svg"></svg>
        <div class="tree-roots">
          <div class="root-box free-root">FREE</div>
          <div class="root-box enslaved-root">ENSLAVED</div>
        </div>
        <div class="tree-rows" id="tree-rows"></div>
      </div>
    </div>

    <div class="record-card">
      <h2 id="record-name">LIFE RECORD</h2>
      <ul class="record-entries" id="record-entries">
        <li class="record-empty">Nothing recorded yet.</li>
      </ul>
    </div>

  </div>

  <!-- FINAL SCREEN -->
  <div id="final-screen">
    <div id="stamp-wrap"></div>
    <p class="status-line" id="status-line"></p>

    <div class="speech-brief" id="speech-brief"></div>

    <div class="full-record" id="full-record-final"></div>

    <div style="margin-top:30px;">
      <button class="restart-btn" id="restart-btn">Run a New Life</button>
    </div>
  </div>

</div>

<script>
(function () {
  const ROUND_TITLES = ["Birth", "A Debt or a War", "Work", "A Turn of Fortune", "Where You End Up"];

  // --- Static option tables. Dynamic (citizenship-aware) text is resolved at roll time. ---

  const ROUND1 = [
    { text: "Born to a wealthy citizen landowning family.", branch: "free", citizenship: "citizen" },
    { text: "Born to a poor but free citizen family.", branch: "free", citizenship: "citizen" },
    { text: "Born to a metic — a free non-citizen resident — family.", branch: "free", citizenship: "metic" },
    { text: "Born to an enslaved mother, inheriting her status.", branch: "enslaved", citizenship: null },
    { text: "Captured as a child during a border conflict, sold into slavery.", branch: "enslaved", citizenship: null },
    { text: "Born free, but your family is enslaved this year after failing to repay a debt.", branch: "enslaved", citizenship: null }
  ];

  const ROUND2 = {
    free: [
      { text: "Your family expands its landholdings." },
      { text: "You begin an apprenticeship in a trade." },
      { text: "You start assisting in a family trading business, like Pasion did." },
      { text: "Your citizenship is challenged in a lawsuit, but you remain free, for now." },
      { text: "You marry into a family with several enslaved household workers." },
      { text: "Your family falls into serious debt." }
    ],
    enslaved: [
      { text: "You are sold to a household in Athens as a domestic servant." },
      { text: "You are sent to work the silver mines at Laurion." },
      { text: "You are trained as a craftsman and allowed to earn a small wage." },
      { text: "You are assigned to manage your owner's farmland." },
      { text: "You are purchased by a merchant who values your business skills, like Pasion's owner once did." },
      { text: "You are given the most difficult labour on the property." }
    ]
  };

  const ROUND3 = {
    free: [
      { text: "Your business fails and you are enslaved to cover the debt.", jump: true },
      { text: "You hold minor public office.", requiresCitizen: true, altText: "You expand your trading network, gaining wealth but not citizenship." },
      { text: "You purchase your first enslaved worker." },
      { text: "You are captured while serving in a military campaign.", jump: true },
      { text: "You continue building your trading business." },
      { text: "You inherit land and money from a relative." }
    ],
    enslaved: [
      { text: "Your owner frees you in their will, but you remain a metic.", jump: true, setCitizenship: "metic" },
      { text: "You buy your own freedom through years of saved earnings, as some miners at Laurion did, and become a metic.", jump: true, setCitizenship: "metic" },
      { text: "You continue working in the mines." },
      { text: "You are sold to a new, harsher owner." },
      { text: "You are given more responsibility managing household affairs." },
      { text: "You attempt to buy your freedom, but fall short of the price." }
    ]
  };

  const ROUND4 = {
    free: [
      { text: "You purchase a second enslaved worker for your household." },
      { text: "Your citizenship is confirmed and secured.", requiresCitizen: true, altText: "Your standing as a trusted metic trader grows." },
      { text: "Your business, like Pasion's, grows into real wealth." },
      { text: "You lose a lawsuit and much of your property." },
      { text: "You remain a metic, working but without citizenship rights.", requiresMetic: true, altText: "A rival briefly challenges your family's citizenship, but you keep it." },
      { text: "Nothing significant changes this round." }
    ],
    enslaved: [
      { text: "You are moved to work as a craftsman in the agora." },
      { text: "Your labour in the mines continues, unchanged." },
      { text: "Your owner begins trusting you with more valuable work." },
      { text: "You are separated from family members through sale." },
      { text: "You continue managing your owner's farmland." },
      { text: "You are treated purely as property, as described in Smith's Dictionary entry on slavery." }
    ]
  };

  const ROUND5 = {
    free: [
      { text: "Free citizen, wealthy — you own land, a business, and several enslaved workers, like Pasion once did.", status: "master" },
      { text: "Free citizen or metic, of moderate means, with no enslaved workers.", status: "free_no_slaves" },
      { text: "Free but poor, struggling to make ends meet.", status: "free_no_slaves" },
      { text: "Your remaining debts catch up with you and you are enslaved.", jump: true, status: "enslaved", clearCitizenship: true },
      { text: "Free citizen, you own land and a modest household including enslaved workers.", status: "master" },
      { text: "Free metic, respected in trade but never granted citizenship.", requiresMetic: true, altText: "Free citizen, respected in trade, of comfortable but unremarkable means.", status: "free_no_slaves" }
    ],
    enslaved: [
      { text: "You finally buy your freedom, becoming a free metic.", jump: true, status: "free_no_slaves", setCitizenship: "metic" },
      { text: "Enslaved for life, working the mines at Laurion.", status: "enslaved" },
      { text: "Enslaved, working as a household servant.", status: "enslaved" },
      { text: "Your owner frees you in old age, but you have little means. You become a metic.", jump: true, status: "free_no_slaves", setCitizenship: "metic" },
      { text: "Enslaved, managing your owner's farmland with some trust and responsibility.", status: "enslaved" },
      { text: "Enslaved, sold again to a new owner.", status: "enslaved" }
    ]
  };

  const SPEECH_BRIEFS = {
    master: {
      stampText: "MASTER",
      stampClass: "",
      statusLine: "Your life has led you to own enslaved people.",
      heading: "Your task: defend owning slaves",
      body: [
        "Write a courtroom speech defending your right to own the people you own.",
        "Base your argument on Aristotle's claim in the Politics that some people are slaves by nature, suited by their character to be ruled. Add the economic case — a household like yours, or a business like Pasion's, needs enslaved labour to function.",
        "Use at least one specific detail from your own life record to support your claim."
      ]
    },
    enslaved: {
      stampText: "ENSLAVED",
      stampClass: "",
      statusLine: "Your life has ended in slavery.",
      heading: "Your task: argue against your own enslavement",
      body: [
        "Write a courtroom speech arguing that your enslavement is a matter of law and circumstance, not nature.",
        "Use Pasion's case as your model — a man who was enslaved, then freed, then became a wealthy and respected banker. Argue that nothing about your nature made you unfit for freedom; only the events of your life placed you here.",
        "Use at least one specific detail from your own life record to support your claim."
      ]
    },
    free_no_slaves: {
      stampText: "FREE",
      stampClass: "free",
      statusLine: "Your life has kept you free, but without enslaved workers of your own.",
      heading: "Your task: argue either side",
      body: [
        "Write a courtroom speech either defending slavery as natural and necessary, or challenging it as unjust and based on law rather than nature.",
        "Choose whichever position your own life record best supports — look back at what happened to you and to people around you, and build your argument from that.",
        "Use at least one specific detail from your own life record to support your claim."
      ]
    }
  };

  // --- State ---
  let charName = "";
  let branch = null;       // 'free' or 'enslaved'
  let citizenship = null;  // 'citizen' | 'metic' | null
  let finalStatus = null;
  let record = [];         // { round, text, col, jumped, citizenTag }
  let currentRound = 1;
  let currentOptions = null;
  let awaitingContinue = false;

  // --- Elements ---
  const nameScreen = document.getElementById("name-screen");
  const nameInput = document.getElementById("name-input");
  const startBtn = document.getElementById("start-btn");
  const gameScreen = document.getElementById("game-screen");
  const finalScreen = document.getElementById("final-screen");

  const roundLabel = document.getElementById("round-label");
  const roundTitle = document.getElementById("round-title");
  const currentBranchLine = document.getElementById("current-branch-line");
  const dieFace = document.getElementById("die-face");
  const rollBtn = document.getElementById("roll-btn");
  const resultBox = document.getElementById("result-box");
  const jumpNote = document.getElementById("jump-note");
  const continueBtn = document.getElementById("continue-btn");
  const recordName = document.getElementById("record-name");
  const recordEntries = document.getElementById("record-entries");

  const treeRows = document.getElementById("tree-rows");
  const treeStage = document.getElementById("tree-stage");
  const connectorSvg = document.getElementById("connector-svg");

  const stampWrap = document.getElementById("stamp-wrap");
  const statusLine = document.getElementById("status-line");
  const speechBrief = document.getElementById("speech-brief");
  const fullRecordFinal = document.getElementById("full-record-final");
  const restartBtn = document.getElementById("restart-btn");

  function resolveOptions(rawArr) {
    // Resolve citizenship-conditional text into final display text, keep other fields.
    return rawArr.map(function (opt) {
      let text = opt.text;
      if (opt.requiresCitizen && citizenship !== "citizen") text = opt.altText;
      if (opt.requiresMetic && citizenship !== "metic") text = opt.altText;
      return Object.assign({}, opt, { text: text });
    });
  }

  function branchWord(b) {
    return b === "free"
      ? '<span class="free-word">free</span>'
      : '<span class="enslaved-word">enslaved</span>';
  }

  function updateBranchLine() {
    if (!branch) { currentBranchLine.innerHTML = "&nbsp;"; return; }
    let extra = "";
    if (branch === "free" && citizenship) extra = " (" + citizenship + ")";
    currentBranchLine.innerHTML = "Currently: " + branchWord(branch) + extra;
  }

  function renderRecordSidebar() {
    if (record.length === 0) {
      recordEntries.innerHTML = '<li class="record-empty">Nothing recorded yet.</li>';
      return;
    }
    recordEntries.innerHTML = record.map(function (r) {
      return '<li><span class="r-num">R' + r.round + '</span>' + r.text + '</li>';
    }).join("");
  }

  function citizenTagHtml(r) {
    if (r.col !== "free" || !r.citizenTag) return "";
    return '<span class="citizen-tag">(' + r.citizenTag + ')</span>';
  }

  function rebuildTree() {
    treeRows.innerHTML = "";
    record.forEach(function (r) {
      const rowSlots = document.createElement("div");
      rowSlots.style.display = "contents";

      const freeSlot = document.createElement("div");
      freeSlot.className = "tree-slot";
      const enslavedSlot = document.createElement("div");
      enslavedSlot.className = "tree-slot";

      const node = document.createElement("div");
      let enterClass = "enter-plain";
      if (r.jumped) {
        enterClass = r.col === "free" ? "enter-cross-to-free" : "enter-cross-to-enslaved";
      }
      node.className = "tree-node " + r.col + " " + enterClass;
      node.innerHTML = '<span class="node-round">ROUND ' + r.round + '</span>' + r.text + citizenTagHtml(r);
      node.id = "tree-node-" + r.round;

      if (r.col === "free") {
        freeSlot.appendChild(node);
      } else {
        enslavedSlot.appendChild(node);
      }

      treeRows.appendChild(freeSlot);
      treeRows.appendChild(enslavedSlot);
    });
    // redraw connectors after layout settles
    requestAnimationFrame(redrawConnectors);
  }

  function redrawConnectors() {
    const stageRect = treeStage.getBoundingClientRect();
    connectorSvg.setAttribute("width", stageRect.width);
    connectorSvg.setAttribute("height", stageRect.height);
    connectorSvg.setAttribute("viewBox", "0 0 " + stageRect.width + " " + stageRect.height);
    connectorSvg.innerHTML = "";

    if (record.length === 0) return;

    const freeRoot = document.querySelector(".root-box.free-root");
    const enslavedRoot = document.querySelector(".root-box.enslaved-root");

    function anchorTop(el) {
      const r = el.getBoundingClientRect();
      return { x: r.left + r.width / 2 - stageRect.left, y: r.top - stageRect.top };
    }
    function anchorBottom(el) {
      const r = el.getBoundingClientRect();
      return { x: r.left + r.width / 2 - stageRect.left, y: r.bottom - stageRect.top };
    }

    let prevAnchor = null;

    record.forEach(function (r, idx) {
      const node = document.getElementById("tree-node-" + r.round);
      if (!node) return;
      const topPt = anchorTop(node);
      const bottomPt = anchorBottom(node);

      let startPt;
      if (idx === 0) {
        const rootEl = r.col === "free" ? freeRoot : enslavedRoot;
        startPt = anchorBottom(rootEl);
      } else {
        startPt = prevAnchor;
      }

      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      const midY = (startPt.y + topPt.y) / 2;
      const d = "M " + startPt.x + " " + startPt.y +
                " C " + startPt.x + " " + midY + ", " +
                topPt.x + " " + midY + ", " +
                topPt.x + " " + topPt.y;
      path.setAttribute("d", d);
      path.setAttribute("fill", "none");
      path.setAttribute("stroke", r.col === "free" ? "#5B6E52" : "#7C2020");
      path.setAttribute("stroke-width", "2");
      path.setAttribute("stroke-opacity", "0.55");
      connectorSvg.appendChild(path);

      prevAnchor = bottomPt;
    });
  }

  function startRound(n) {
    currentRound = n;
    awaitingContinue = false;
    roundLabel.textContent = "ROUND " + n + " OF 5";
    roundTitle.textContent = ROUND_TITLES[n - 1];
    updateBranchLine();
    dieFace.textContent = "?";
    dieFace.classList.remove("rolling");
    resultBox.classList.remove("show");
    resultBox.textContent = "";
    jumpNote.textContent = "";
    continueBtn.classList.remove("show");
    rollBtn.disabled = false;
    rollBtn.textContent = "Roll the Die";

    if (n === 1) {
      currentOptions = ROUND1;
    } else if (n === 2) {
      currentOptions = resolveOptions(ROUND2[branch]);
    } else if (n === 3) {
      currentOptions = resolveOptions(ROUND3[branch]);
    } else if (n === 4) {
      currentOptions = resolveOptions(ROUND4[branch]);
    } else if (n === 5) {
      currentOptions = resolveOptions(ROUND5[branch]);
    }
  }

  function doRoll() {
    if (awaitingContinue) return;
    rollBtn.disabled = true;
    dieFace.classList.add("rolling");

    let ticks = 0;
    const spin = setInterval(function () {
      dieFace.textContent = String(1 + Math.floor(Math.random() * 6));
      ticks++;
      if (ticks > 8) {
        clearInterval(spin);
        finishRoll();
      }
    }, 60);
  }

  function finishRoll() {
    const roll = 1 + Math.floor(Math.random() * 6);
    dieFace.textContent = roll;
    dieFace.classList.remove("rolling");

    const outcome = currentOptions[roll - 1];

    resultBox.textContent = outcome.text;
    resultBox.classList.add("show");

    if (currentRound === 1) {
      branch = outcome.branch;
      citizenship = outcome.citizenship;
    }

    let jumped = false;
    if (outcome.jump) {
      jumped = true;
      branch = branch === "free" ? "enslaved" : "free";
    }
    if (outcome.setCitizenship) citizenship = outcome.setCitizenship;
    if (outcome.clearCitizenship) citizenship = null;

    record.push({
      round: currentRound,
      text: outcome.text,
      col: branch,
      jumped: jumped,
      citizenTag: branch === "free" ? citizenship : null
    });

    renderRecordSidebar();
    rebuildTree();
    updateBranchLine();

    if (jumped) {
      jumpNote.textContent = "This turn changes everything — your path now crosses to " + (branch === "free" ? "the free side" : "enslavement") + ".";
    } else {
      jumpNote.textContent = "";
    }

    if (currentRound === 5) {
      finalStatus = outcome.status;
    }

    awaitingContinue = true;
    continueBtn.classList.add("show");
    continueBtn.textContent = currentRound === 5 ? "See the Verdict" : "Continue to Round " + (currentRound + 1);
  }

  function handleContinue() {
    if (currentRound === 5) {
      showFinal();
    } else {
      startRound(currentRound + 1);
    }
  }

  function showFinal() {
    gameScreen.classList.remove("active");
    finalScreen.classList.add("active");

    const brief = SPEECH_BRIEFS[finalStatus];
    stampWrap.innerHTML = '<div class="stamp ' + brief.stampClass + '">' + brief.stampText + '</div>';
    statusLine.textContent = charName + " — " + brief.statusLine;

    speechBrief.innerHTML =
      '<h3>' + brief.heading + '</h3>' +
      brief.body.map(function (p) { return '<p>' + p + '</p>'; }).join("");

    fullRecordFinal.innerHTML =
      '<h3>Full life record</h3>' +
      '<ul class="record-entries">' +
      record.map(function (r) {
        return '<li><span class="r-num">R' + r.round + '</span>' + r.text + citizenTagHtml(r) + '</li>';
      }).join("") +
      '</ul>';
  }

  function resetAll() {
    charName = "";
    branch = null;
    citizenship = null;
    finalStatus = null;
    record = [];
    currentRound = 1;
    nameInput.value = "";
    treeRows.innerHTML = "";
    connectorSvg.innerHTML = "";
    finalScreen.classList.remove("active");
    nameScreen.style.display = "block";
    gameScreen.classList.remove("active");
  }

  startBtn.addEventListener("click", function () {
    const val = nameInput.value.trim();
    charName = val.length > 0 ? val : "Your character";
    nameScreen.style.display = "none";
    gameScreen.classList.add("active");
    recordName.textContent = charName.toUpperCase() + "'S LIFE RECORD";
    startRound(1);
  });

  nameInput.addEventListener("keydown", function (e) {
    if (e.key === "Enter") startBtn.click();
  });

  rollBtn.addEventListener("click", doRoll);
  continueBtn.addEventListener("click", handleContinue);
  restartBtn.addEventListener("click", resetAll);

  let resizeTimer;
  window.addEventListener("resize", function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(redrawConnectors, 150);
  });
})();
</script>
</body>
</html>
